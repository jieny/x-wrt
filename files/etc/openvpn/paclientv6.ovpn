client
dev tun
remote pa.11221199.xyz 1195 tcp
tun-mtu 1500
tls-client
nobind
user nobody
group nogroup
ping 15
ping-restart 45
persist-tun
persist-key
mute-replay-warnings
verb 3
cipher AES-256-GCM
auth none
#pull
route-nopull
#auth-user-pass
auth-user-pass paclientv6.auth
connect-retry 1
reneg-sec 3600
remote-cert-tls server
log /tmp/openvpn-client-pav6.log
#route 172.18.0.0 255.255.240.0
